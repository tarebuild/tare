# The site's own origin (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:7801
# The backend API the server components read.
API_URL=http://127.0.0.1:7810
# One-line installer: `installLine` from the API's GET /v1/config (it carries the API's public origin).
NEXT_PUBLIC_INSTALL_LINE=
# TARE, once they exist.
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TOKEN_VENUE=
# Outside links shown in the footer when set.
NEXT_PUBLIC_X_URL=
