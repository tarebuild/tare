{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "generatedCorpusHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "recordedCorpusHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "capturedStockHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "replayStockHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sameStockBinary": {
        "type": "boolean"
      },
      "validatorReproduction": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "matched": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clockExactInputs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "firstDifference": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "inputs",
          "matched",
          "failed",
          "clockExactInputs",
          "firstDifference"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "generatedCorpusHash",
      "recordedCorpusHash",
      "capturedStockHash",
      "replayStockHash",
      "sameStockBinary",
      "validatorReproduction"
    ],
    "additionalProperties": {}
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "RecordedCorpus"
}
