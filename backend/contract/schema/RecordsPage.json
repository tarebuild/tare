{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
          },
          "program": {
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 44,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "address"
            ],
            "additionalProperties": false
          },
          "attester": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
          },
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "repository",
              "commit"
            ],
            "additionalProperties": false
          },
          "toolchainVersion": {
            "type": "string",
            "minLength": 1
          },
          "stockBuildHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tareBuildHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "corpus": {
            "type": "object",
            "properties": {
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "counts": {
                "type": "object",
                "properties": {
                  "tests": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "generated": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mainnet": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tests",
                  "generated",
                  "mainnet"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "hash",
              "counts"
            ],
            "additionalProperties": false
          },
          "gross": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "net": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tare": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reportHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reportLocation": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "flags": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "address",
          "program",
          "attester",
          "source",
          "toolchainVersion",
          "stockBuildHash",
          "tareBuildHash",
          "corpus",
          "gross",
          "net",
          "tare",
          "reportHash",
          "reportLocation",
          "slot",
          "createdAt",
          "flags"
        ],
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "nextCursor",
        "hasMore"
      ],
      "additionalProperties": false
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "items",
    "page",
    "asOf"
  ],
  "additionalProperties": false,
  "title": "RecordsPage"
}
