{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "const": "TARE"
    },
    "supply": {
      "type": "number",
      "const": 1000000000
    },
    "mint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 32,
          "maxLength": 44,
          "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "venue": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "developerAllocationShare": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "developerAllocationLock": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 32,
          "maxLength": 44,
          "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Streamflow lock holding the developer allocation."
    },
    "feesReceivedLamports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Attest fees paid to the launch wallet, summed over indexed records: the same sum as `RegistryTotals.feesAccruedLamports`. Trading fees are in `bySource.trading`."
    },
    "spentLamports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "SOL the crank spent buying TARE, summed over its transactions."
    },
    "burned": {
      "type": "number",
      "minimum": 0,
      "description": "TARE the crank burned, in whole tokens."
    },
    "burns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "minLength": 64,
            "maxLength": 88,
            "description": "The crank transaction, checkable on any explorer."
          },
          "kind": {
            "type": "string",
            "enum": [
              "buy",
              "burn",
              "claim"
            ],
            "description": "`buy`: the swap and the burn of its quoted minimum in one transaction. `burn`: the rest that swap delivered. `claim`: a trading-fee claim, its claimer share sent on and its TARE burn share burned."
          },
          "source": {
            "type": "string",
            "enum": [
              "attest",
              "trading"
            ],
            "description": "What paid for it: attest fees, or the burn share of the pool's trading fees."
          },
          "spentLamports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "SOL the launch wallet spent in this transaction, its fee left out."
          },
          "burned": {
            "type": "number",
            "minimum": 0,
            "description": "TARE burned in this transaction, in whole tokens."
          },
          "claimedLamports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "For a claim: the SOL side of the trading fees claimed."
          },
          "keptLamports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "For a claim: the claimer's share, sent to the recipient."
          },
          "claimSignature": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 88
              },
              {
                "type": "null"
              }
            ],
            "description": "For a trading-fee row: the claim transaction it comes from (its own signature on a claim). Null for attest-fee rows."
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "signature",
          "kind",
          "source",
          "spentLamports",
          "burned",
          "claimedLamports",
          "keptLamports",
          "claimSignature",
          "slot",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "The latest crank transactions, newest first, at most 20."
    },
    "bySource": {
      "type": "object",
      "properties": {
        "attest": {
          "type": "object",
          "properties": {
            "feesReceivedLamports": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Attest fees paid to the launch wallet."
            },
            "spentLamports": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "burned": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "feesReceivedLamports",
            "spentLamports",
            "burned"
          ],
          "additionalProperties": false
        },
        "trading": {
          "type": "object",
          "properties": {
            "feesReceivedLamports": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The SOL side of the trading fees the crank claimed."
            },
            "keptLamports": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The claimer's share of those claims, sent to the recipient."
            },
            "spentLamports": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "burned": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "feesReceivedLamports",
            "keptLamports",
            "spentLamports",
            "burned"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "attest",
        "trading"
      ],
      "additionalProperties": false,
      "description": "The same totals split by what paid for them."
    }
  },
  "required": [
    "ticker",
    "supply",
    "mint",
    "venue",
    "developerAllocationShare",
    "developerAllocationLock",
    "feesReceivedLamports",
    "spentLamports",
    "burned",
    "burns",
    "bySource"
  ],
  "additionalProperties": false,
  "title": "TokenFacts"
}
