{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "program": {
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 44,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "address"
            ],
            "additionalProperties": false
          },
          "anchor": {
            "type": "boolean"
          },
          "hasIdl": {
            "type": "boolean"
          },
          "binarySize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rentLamports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "transactions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "signaturesExamined": {
            "description": "Signature rows examined during this sampling run. Omitted in older samples where the count is unknown.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "discriminator": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{2}){1,32}$"
                },
                "calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "median": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "p90": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "totalUnits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "name",
                "discriminator",
                "calls",
                "median",
                "p90",
                "totalUnits",
                "share"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "program",
          "anchor",
          "hasIdl",
          "binarySize",
          "rentLamports",
          "sampledAt",
          "transactions",
          "instructions"
        ],
        "additionalProperties": false
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "items",
    "asOf"
  ],
  "additionalProperties": false,
  "title": "RecentWeighings"
}
