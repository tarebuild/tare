{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rentLamports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "hash",
    "sizeBytes",
    "rentLamports"
  ],
  "additionalProperties": false,
  "title": "Build"
}
