# Node 22. MODE defaults to fixture; local HOST=127.0.0.1, API PORT=7810.
MODE=
HOST=
PORT=
# Required for MODE=chain. Local PostgreSQL URL is in ignored .env.
DATABASE_URL=
# Exact comma-separated browser origins; defaults to local web ports 7800 and 7801.
CORS_ORIGINS=
# Registry cluster: localnet (default), devnet, mainnet.
CLUSTER=
# RPC_URL is the preferred registry endpoint; SOLANA_RPC_URL remains an alias.
RPC_URL=
SOLANA_RPC_URL=
REGISTRY_PROGRAM_ID=
# Default: registry/target/idl/tare_registry.json. Missing file/ID means waiting.
REGISTRY_IDL_PATH=
# Defaults: localnet confirmed / other clusters finalized.
REGISTRY_COMMITMENT=
# Defaults: localnet 2000 / other clusters 15000 milliseconds.
INDEXER_POLL_MS=
# Defaults: localnet 50 / other clusters 5 RPC methods per second.
REGISTRY_RPC_RPS=
# Mainnet weighing is separate and only runs on request.
HELIUS_RPC_URL=
# Defaults: target 50 usable transactions (1-100), cached 900 seconds.
WEIGH_SAMPLE_SIZE=
WEIGH_CACHE_SECONDS=
# Public web URL; /v1/config returns null until set.
SITE_PUBLIC_URL=
# Public API origin enables installLine. Default release base is API_PUBLIC_URL/releases.
API_PUBLIC_URL=
# Optional external release directory URL (GitHub release or bucket).
RELEASES_BASE_URL=
# JWT requires gateway; gateway alone enables public pinned report reads.
PINATA_JWT=
PINATA_GATEWAY=
# Blank until the token exists; returned as null.
TOKEN_MINT=
TOKEN_VENUE=
